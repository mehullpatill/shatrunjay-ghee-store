generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum DiscountKind {
  PROMO
  COUPON
  REFERRAL
}

enum DiscountType {
  PERCENT
  FIXED
}

enum CartStatus {
  ACTIVE
  LOCKED
  CONVERTED
  ABANDONED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  COD_PENDING
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

model User {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  phone          String?
  passwordHash   String
  role           UserRole     @default(CUSTOMER)
  referralCode   String       @unique
  referredByCode String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  carts          Cart[]
  orders         Order[]
  orderQueries   OrderQuery[]
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
}

model SiteSetting {
  id                        String       @id @default("default")
  siteContentJson           Json         @default("{}")
  shippingChargePaise       Int          @default(0)
  minOrderAmountPaise       Int          @default(0)
  codEnabled                Boolean      @default(true)
  onlinePaymentEnabled      Boolean      @default(true)
  otpRequired               Boolean      @default(true)
  deliveryTimeText          String       @default("2–3 days in Mumbai; 5–7 working days outside Mumbai")
  referralSystemEnabled     Boolean      @default(false)
  referralDiscountType      DiscountType @default(PERCENT)
  referralDiscountValue     Int          @default(10)
  referralMaxDiscountInr    Int?         @default(250)
  updatedAt                 DateTime     @updatedAt
}

model Product {
  id             String      @id @default(cuid())
  sku            String      @unique
  name           String
  slug           String      @unique
  description    String      @default("")
  pricePaise     Int         @default(0)
  mrpPaise       Int?
  imageUrl       String?
  videoUrl       String?
  inStock        Boolean     @default(true)
  stockQty       Int         @default(100)
  packLabel      String?
  isFeatured     Boolean     @default(false)
  isMostBought   Boolean     @default(false)
  isFreshArrival Boolean     @default(false)
  isActive       Boolean     @default(true)
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  cartItems      CartItem[]
  cartLocks      CartLock[]
  orderItems     OrderItem[]
}

model CodPincode {
  id       String  @id @default(cuid())
  pincode  String  @unique
  city     String?
  state    String?
  isMumbai Boolean @default(false)
  isActive Boolean @default(true)
}

model DiscountCode {
  id             String       @id @default(cuid())
  code           String       @unique
  kind           DiscountKind @default(PROMO)
  discountType   DiscountType @default(PERCENT)
  value          Int
  maxDiscountInr Int?
  minOrderInr    Int          @default(0)
  usageLimit     Int?
  usedCount      Int          @default(0)
  showOnSite     Boolean      @default(false)
  isActive       Boolean      @default(true)
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
}

model Cart {
  id               String     @id @default(cuid())
  sessionToken     String     @unique
  userId           String?
  user             User?      @relation(fields: [userId], references: [id])
  status           CartStatus @default(ACTIVE)
  lockedUntil      DateTime?
  appliedCode      String?
  emailForRecovery String?
  customerName     String?
  lastActivityAt   DateTime   @default(now())
  reminderSentAt   DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  items            CartItem[]
  locks            CartLock[]

  @@index([status, lastActivityAt])
}

model CartItem {
  id         String  @id @default(cuid())
  cartId     String
  cart       Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int

  @@unique([cartId, productId])
}

model CartLock {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
  @@index([expiresAt])
}

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique
  channel             String        @default("WEB")
  userId              String?
  user                User?         @relation(fields: [userId], references: [id])
  cartId              String?
  customerName        String
  customerEmail       String
  customerPhone       String
  shippingAddress     String
  area                String?
  city                String
  state               String
  pincode             String
  isMumbai            Boolean       @default(false)
  deliveryEtaText     String
  paymentMethod       PaymentMethod
  paymentStatus       PaymentStatus @default(PENDING)
  orderStatus         OrderStatus   @default(PLACED)
  subtotalInr         Int
  discountInr         Int           @default(0)
  discountCodeUsed    String?
  totalInr            Int
  razorpayOrderId     String?       @unique
  razorpayPaymentId   String?
  razorpaySignature   String?
  courierName         String?
  trackingNumber      String?
  courierDispatchDate DateTime?
  courierImageUrl     String?
  consentAccepted     Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  queries             OrderQuery[]

  @@index([customerEmail])
  @@index([customerPhone])
  @@index([createdAt(sort: Desc)])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  sku          String
  productName  String
  quantity     Int
  unitPriceInr Int
  lineTotalInr Int
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

model OrderQuery {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  subject   String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
}

model ContactInquiry {
  id             String   @id @default(cuid())
  source         String   @default("CONTACT")
  firstName      String
  lastName       String?
  whatsappNumber String
  email          String?
  message        String
  createdAt      DateTime @default(now())
}

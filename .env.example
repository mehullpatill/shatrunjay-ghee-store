# Required for local development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Core application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret

# Commerce backend
# Use "leadr" to use the client project's shared Leadr commerce backend.
# Keep "prisma" while testing the local commerce implementation.
COMMERCE_BACKEND=leadr
NEXT_PUBLIC_COMMERCE_BACKEND=leadr
LEADR_API_URL=https://leadr.example.com/api/v1
LEADR_API_KEY=replace-with-leadr-api-key
SHOP_ORG_ID=replace-with-leadr-organization-id

# Optional client-project admin/identity integration
NEXT_PUBLIC_RAHTSAA_ID_URL=https://id.rahtsaaai.com
DEV_ADMIN_TOKEN=

# Admin seed (required only when running prisma:seed)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-a-12-character-password

# Razorpay
RAZORPAY_KEY_ID=rzp_test_replace_me
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# S3 uploads
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
S3_BUCKET_NAME=replace-me
S3_PUBLIC_BASE_URL=https://media.example.com

# SES email
SES_FROM_EMAIL=no-reply@example.com
SES_BUSINESS_INBOX_EMAIL=info@example.com

# Optional integrations
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=

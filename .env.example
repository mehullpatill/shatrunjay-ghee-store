# ==========================================
# Database (PostgreSQL via Prisma)
# ==========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/shatrunjay_ghee?schema=public"

# ==========================================
# Security & Auth
# ==========================================
# Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-64-char-random-hex-secret"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Initial Admin Account (seeded via prisma/seed.ts)
ADMIN_EMAIL="admin@shatrunjayghee.com"
ADMIN_PASSWORD="ChangeThisStrongAdminPassword!123"
ADMIN_NAME="Shatrunjay Admin"

# Cron Secret for Abandoned Cart Cleanup & Recovery Emails
CRON_SECRET="replace-with-random-cron-secret"

# ==========================================
# AWS S3 Storage (Media, PDFs, Videos, Logos)
# ==========================================
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
# Optional CloudFront or custom public S3 base URL
AWS_S3_PUBLIC_URL=""

# ==========================================
# Razorpay Payment Gateway
# ==========================================
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ==========================================
# SMTP Email (All Inquiries & Order Notifications)
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@shatrunjayghee.com"
SMTP_PASS=""
SMTP_FROM="Shatrunjay Ghee <info@shatrunjayghee.com>"
ADMIN_INQUIRY_EMAIL="info@shatrunjayghee.com"

# ==========================================
# Google Places API (Home Page Customer Reviews)
# ==========================================
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""
